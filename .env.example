LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser tools (see src/browser.py)
# BROWSER_HEADLESS=true to hide the Chromium window, false to watch it work
BROWSER_HEADLESS=true
# Navigation and action timeout in milliseconds
BROWSER_TIMEOUT_MS=15000
# BROWSER_MOCK=1 returns canned pages instead of launching Chromium
# (use when running simulations or unit tests)
BROWSER_MOCK=

# Web search (see src/search_backend.py)
# Search engines to try, one per attempt, in preference order
SEARCH_BACKENDS=yahoo,duckduckgo
# Seconds a single attempt may spend on the network before it counts as a timeout
SEARCH_TIMEOUT_SECONDS=6
# How many attempts a search gets before it reports failure
SEARCH_MAX_ATTEMPTS=3
# Total seconds a search may spend (retries included) before giving up
SEARCH_TOTAL_TIMEOUT_SECONDS=20
# Range, in seconds, between two consecutive searches (rate limiting)
SEARCH_MIN_GAP_SECONDS=3
SEARCH_MAX_GAP_SECONDS=5
